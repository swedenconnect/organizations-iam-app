<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 https://maven.apache.org/xsd/assembly-1.1.3.xsd">
  <id>plugins</id>

  <formats>
    <format>zip</format>
  </formats>

  <!-- Everything lands under one directory, so unpacking never scatters JARs. -->
  <includeBaseDirectory>true</includeBaseDirectory>
  <baseDirectory>keycloak-plugins-${project.version}</baseDirectory>

  <dependencySets>
    <dependencySet>
      <outputDirectory>/</outputDirectory>
      <!-- The module itself is a POM, so there is no project artifact to include. -->
      <useProjectArtifact>false</useProjectArtifact>
      <!--
        Direct dependencies only. The plugins declare the Keycloak SPI and Jackson as
        provided, but a compile-scoped annotation library would otherwise follow them into
        the ZIP, and Keycloak has no use for it.
      -->
      <useTransitiveDependencies>false</useTransitiveDependencies>
      <unpack>false</unpack>
      <scope>runtime</scope>
    </dependencySet>
  </dependencySets>

</assembly>

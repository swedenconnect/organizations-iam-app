<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>se.swedenconnect.iam</groupId>
    <artifactId>iam-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <groupId>se.swedenconnect.iam.demo</groupId>
  <artifactId>demo</artifactId>
  <packaging>pom</packaging>

  <name>Sweden Connect :: IAM :: Demo</name>
  <description>Demo applications illustrating IAM integration patterns</description>
  <url>https://www.swedenconnect.se</url>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!--
    The demo modules are built, and their Docker images published, with the rest of the project, but they are
    not published to Maven Central. The Central publishing plugin of the release profile reads this property,
    and every module below inherits it. internal/scripts/check-release-version.sh reads it too, so the
    modules skipped here are the ones the version check leaves out.
  -->
  <properties>
    <skipPublishing>true</skipPublishing>
  </properties>

  <modules>
    <module>demo-app</module>
    <module>demo-service</module>
  </modules>

</project>
